# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.
# 웹 배포(Vercel)는 같은 이름으로 [Project → Settings → Environment Variables]에 넣습니다.

# ── 접근 모드 ──────────────────────────────────────────────
# local: 이 컴퓨터에서만(로그인 없음) · web: Supabase 로그인 필수 (Vercel은 web)
APP_ACCESS_MODE=local
# 공개 주소 (웹: https://withbook.vercel.app)
APP_ORIGIN=
# PDF를 만들 때 서버 안 브라우저가 여는 주소. 비우면 APP_ORIGIN → 요청 주소 순으로 사용
INTERNAL_APP_URL=

# ── Supabase ──────────────────────────────────────────────
# 공개 값 (브라우저에 노출돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=https://tboxtseswieqqzniakkb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RfAEv_wz7A2EYowgBsfvkQ_Jj9JBqZs
# 서버 전용 비밀 키 (Supabase → Project Settings → API Keys → Secret keys, sb_secret_…)
SUPABASE_SECRET_KEY=
# DB 연결 (Supabase → Connect). 비밀번호 자리에 DB 비밀번호. 앱 표는 withbook 스키마
#  DATABASE_URL: Transaction pooler(6543) — 서버리스용. connection_limit=5(함수 하나가 여는 연결 수), pool_timeout=20(연결 대기 초)
#  DIRECT_URL:   Session pooler 또는 Direct(5432) — 스키마 반영·이전 스크립트용
DATABASE_URL="postgresql://postgres.tboxtseswieqqzniakkb:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&schema=withbook"
DIRECT_URL="postgresql://postgres.tboxtseswieqqzniakkb:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=withbook"
# PDF 조판용 내부 토큰 서명 키 — 웹 배포는 전용 임의 값 권장(예: openssl rand -hex 32). 비우면 SUPABASE_SECRET_KEY 사용(경고 로그)
RENDER_SECRET=

# ── AI (선택) ─────────────────────────────────────────────
# 앱의 [책 설정 → AI 설정]에 저장한 값이 우선. 비어 있을 때만 아래 값을 쓴다
LLM_BASE_URL=https://gw.letsur.ai          # /v1 을 붙이지 않음
LLM_API_KEY=
LLM_AUTH_SCHEME=x-api-key                   # x-api-key | bearer
LLM_MODEL=claude-fable-5-1
# 웹 모드에서 AI 기본 주소로 허용할 호스트(쉼표 목록, 하위 도메인 포함). 비우면 https 공개 주소면 모두 허용(내부망 주소는 항상 거부)
# 예: AI_ALLOWED_HOSTS=gw.letsur.ai,generativelanguage.googleapis.com,api.openai.com,api.anthropic.com
AI_ALLOWED_HOSTS=

# ── 로컬 전용 ─────────────────────────────────────────────
INSTRUCTION_PATH=./instruction.md
STYLE_REFERENCE_DIR=./style reference
PDF_BROWSER_PATH=
DATA_DIR=./data
